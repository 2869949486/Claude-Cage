[Unit]
Description=Website support assistant
After=network-online.target

[Service]
User=nobody
WorkingDirectory=/opt/cage-support
EnvironmentFile=/etc/cage-support/model.env
ExecStart=/opt/cage-support/server
Restart=on-failure
RestartSec=4
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
